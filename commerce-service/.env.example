# Ports of the local environment on your machine. The defaults below are used when there is no .env file.
#
# If one of them is already taken by another project (another Postgres container on 5432, for example):
#   cp .env.example .env      # .env is git-ignored: it is your personal setup
#   then change the port(s) in .env and run `make down && make up`
#
# The same file is read by Docker Compose, by the "local" Spring profile (make run) and by scripts/get-token.sh,
# so every component agrees on the ports.

COMMERCE_POSTGRES_PORT=5432
COMMERCE_KAFKA_PORT=9092
COMMERCE_KEYCLOAK_PORT=8180
COMMERCE_KAFKA_UI_PORT=8085
