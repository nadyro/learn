# Consistent basic formatting in every editor. Java formatting itself is enforced by Spotless.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,xml}]
indent_size = 2

[{pom.xml,*.java}]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
